NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

MONGO_URI=mongodb://localhost:27017/codementor_ai
ENABLE_MONGO_TRANSACTIONS=false

JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false

API_RATE_LIMIT=300
AUTH_RATE_LIMIT=8
REGISTER_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
AI_ROUTE_RATE_LIMIT=40
ADMIN_WRITE_RATE_LIMIT=80

REDIS_URL=redis://localhost:6379
ENABLE_QUEUE=false

ENABLE_AI=false
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ENABLE_RAG=false

DAILY_MENTOR_LIMIT=10
DAILY_ROADMAP_LIMIT=1
DAILY_QUIZ_EXPLANATION_LIMIT=3
WEEKLY_REPORT_LIMIT=1

DAILY_PROJECT_REVIEW_LIMIT=5
DAILY_INTERVIEW_FEEDBACK_LIMIT=5

# Cache behavior
CACHE_DASHBOARD_TTL_SECONDS=30
CACHE_CONTENT_TTL_SECONDS=600

OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
MAX_MENTOR_PROMPT_CHARS=1000
MAX_PROJECT_CODE_CHARS=15000
MAX_PROJECT_EXPLANATION_CHARS=4000
MAX_INTERVIEW_ANSWER_CHARS=3000
MAX_AI_CONTEXT_CHARS=5000
AI_REPEAT_WINDOW_MINUTES=10
AI_REPEAT_LIMIT=3

ENABLE_DEMO_MODE=false
ALLOW_DEV_EMAIL_LOG=true
