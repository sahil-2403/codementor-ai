NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false

MONGO_URI=mongodb://localhost:27017/codementor_ai

JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

API_RATE_LIMIT=300
AUTH_RATE_LIMIT=8
REGISTER_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
AI_ROUTE_RATE_LIMIT=40
ADMIN_WRITE_RATE_LIMIT=80

ENABLE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000

DAILY_MENTOR_LIMIT=10
DAILY_ROADMAP_LIMIT=1
DAILY_QUIZ_EXPLANATION_LIMIT=3
WEEKLY_REPORT_LIMIT=1
DAILY_PRACTICE_REVIEW_LIMIT=5
DAILY_INTERVIEW_FEEDBACK_LIMIT=5

MAX_MENTOR_PROMPT_CHARS=1000
MAX_PRACTICE_CODE_CHARS=15000
MAX_PRACTICE_EXPLANATION_CHARS=4000
MAX_INTERVIEW_ANSWER_CHARS=3000
MAX_AI_CONTEXT_CHARS=5000

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=CodeMentor AI
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_VERIFY_CONNECTION=true
ALLOW_DEV_EMAIL_LOG=true
