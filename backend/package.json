{
  "name": "codementor-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for CodeMentor AI",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/runSeed.js",
    "worker": "node src/workers/index.js",
    "migrate:attempt-numbers": "node src/migrations/backfillAttemptNumbers.js",
    "migrate:attempt-indexes": "node src/migrations/enforceAttemptIndexes.js",
    "migrate:roadmap-indexes": "node src/migrations/enforceRoadmapIndexes.js",
    "migrate:question-archive-indexes": "node src/migrations/fixQuestionArchiveIndexes.js",
    "test": "node --test --test-concurrency=1 ./test/unit/backend.test.js",
    "check:gemini": "node scripts/checkGemini.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.15",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
